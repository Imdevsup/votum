# --- Database ---
# SQLite for local dev. Swap to a postgres URL in production and update
# datasource.provider in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# --- Auth / sessions ---
# Used to sign session cookies. 32+ random characters.
SESSION_SECRET="change-me-replace-with-32-byte-hex-string"

# --- Firebase ---
# Required: the Firebase project ID. ID tokens are verified against this.
FIREBASE_PROJECT_ID=""
# Optional: paste the contents of a service-account JSON here (single line,
# JSON-escaped) for environments without Application Default Credentials.
# Leave blank in environments where ADC is configured (most Cloud hosts) or
# where you've set GOOGLE_APPLICATION_CREDENTIALS to a JSON file path.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- URLs ---
# The marketing/auth-done origin. The backend redirects users here after OAuth.
WEB_BASE_URL="http://localhost:5173"
# Public origin of the API itself.
PUBLIC_API_URL="http://localhost:3000"

# --- Cookies ---
# Leave blank for localhost development. In prod use ".votum.dev" so the
# cookie is shared between votum.dev and api.votum.dev.
COOKIE_DOMAIN=""

# --- Admin ---
# Long random string. Anyone holding this can review the manual queue.
ADMIN_TOKEN="set-a-long-random-string"

# --- Runtime ---
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"
