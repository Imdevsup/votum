# --- Database ---
# Postgres URL. For local dev: any Postgres works. For prod: auto-injected
# by the Vercel/Neon Marketplace integration.
DATABASE_URL=""

# --- Auth / sessions ---
SESSION_SECRET="change-me-replace-with-32-byte-hex-string"

# --- GitHub OAuth App ---
# Create one at https://github.com/settings/developers
# Authorization callback URL on GitHub MUST match GITHUB_OAUTH_REDIRECT.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT="http://localhost:3000/v1/auth/github/callback"

# --- URLs ---
WEB_BASE_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:3000"

# --- Cookies ---
# Leave blank for localhost. In prod use ".votum.dev" or similar so the
# session cookie is shared across subdomains.
COOKIE_DOMAIN=""

# --- Admin ---
ADMIN_TOKEN="set-a-long-random-string"

# --- Runtime ---
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"
